# PostgreSQL 数据库名/用户/密码（必填）
POSTGRES_DB=app_web
POSTGRES_USER=fsdx
POSTGRES_PASSWORD=change-me-in-production-strong-password

# JWT access token 密钥（务必修改为强随机字符串，至少 32 位）
JWT_SECRET=change-me-in-production-at-least-32-characters-long

# 日志级别：fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# 宿主映射端口（可选）
APP_PORT=3000
DB_PORT=14010
